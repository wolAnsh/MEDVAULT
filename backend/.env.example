# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/MEDVAULT_REPORTS

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_random_jwt_secret_here_min_64_chars

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI & Medical RAG ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here_optional
PINECONE_INDEX=medvault-medical-kb

# ── App Config ────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SHARE_LINK_TTL_MINUTES=60

# ── Nodemailer / Email Setup ──────────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

